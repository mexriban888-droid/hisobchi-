generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
 USER
 ADMIN
 OWNER
}
enum TransactionType {
 INCOME
 EXPENSE
}
enum SubscriptionAction {
 GRANT
 EXTEND
 REVOKE
 EXPIRE
}
enum DurationUnit {
 DAYS
 MONTHS
}
model User {
 id String @id @default(cuid())
 telegramId BigInt @unique
 username String?
 firstName String?
 lastName String?
 languageCode String @default("ru")
 role Role @default(USER)
 isBanned Boolean @default(false)
 bannedAt DateTime?
 banReason String?
 createdAt DateTime @default(now())
 lastActivityAt DateTime @default(now())
 botStartedAt DateTime?
 miniAppFirstOpenedAt DateTime?
 miniAppLastOpenedAt DateTime?
 accessRequestedAt DateTime?
 accessRequestStatus String?
 categories Category[]
 transactions Transaction[]
 subscription Subscription?
 subscriptionEvents SubscriptionEvent[] @relation("subscriptionTarget")
 grantedSubscriptions Subscription[] @relation("grantedBy")
 auditActions AdminAuditLog[] @relation("auditActor")
 auditTargets AdminAuditLog[] @relation("auditTarget")
 broadcasts Broadcast[]
}
model Category {
 id String @id @default(cuid())
 userId String
 name String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 transactions Transaction[]
 @@unique([userId,name])
}
model Transaction {
 id String @id @default(cuid())
 userId String
 type TransactionType
 amountUzs BigInt
 categoryId String?
 comment String?
 occurredAt DateTime
 rateUzsPerUsd Decimal @db.Decimal(20,6)
 rateDate DateTime @db.Date
 amountUsdSnapshot Decimal @db.Decimal(20,6)
 fxIsFallback Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 category Category? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
 @@index([userId,occurredAt])
 @@index([userId,type,occurredAt])
 @@index([userId,categoryId,occurredAt])
}
model ExchangeRate {
 id String @id @default(cuid())
 currencyCode String @default("USD")
 rateDate DateTime @db.Date
 rateUzsPerUsd Decimal @db.Decimal(20,6)
 source String @default("CBU")
 fetchedAt DateTime @default(now())
 @@unique([currencyCode,rateDate])
}
model Subscription {
 id String @id @default(cuid())
 userId String @unique
 startsAt DateTime
 endsAt DateTime
 revokedAt DateTime?
 grantedByAdminId String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 grantedByAdmin User? @relation("grantedBy",fields:[grantedByAdminId],references:[id])
}
model SubscriptionEvent {
 id String @id @default(cuid())
 userId String
 adminId String?
 action SubscriptionAction
 durationValue Int?
 durationUnit DurationUnit?
 previousExpiresAt DateTime?
 newExpiresAt DateTime?
 occurredAt DateTime @default(now())
 reason String?
 requestKey String? @unique
 user User @relation("subscriptionTarget",fields:[userId],references:[id],onDelete:Cascade)
}
model AdminAuditLog {
 id String @id @default(cuid())
 actorAdminId String
 targetUserId String?
 action String
 safeMetadata Json?
 createdAt DateTime @default(now())
 actor User @relation("auditActor",fields:[actorAdminId],references:[id])
 target User? @relation("auditTarget",fields:[targetUserId],references:[id])
 @@index([actorAdminId,createdAt])
}
model Broadcast {
 id String @id @default(cuid())
 adminId String
 text String
 status String @default("PENDING")
 totalRecipients Int @default(0)
 sentCount Int @default(0)
 failedCount Int @default(0)
 createdAt DateTime @default(now())
 finishedAt DateTime?
 admin User @relation(fields:[adminId],references:[id])
}
